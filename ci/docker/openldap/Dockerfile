# OpenLDAP image built from Debian 13 (Trixie)
FROM debian:trixie

LABEL org.opencontainers.image.title="openldap-rudi" \
      org.opencontainers.image.description="OpenLDAP server for RUDI platform" \
      org.opencontainers.image.base.name="debian:trixie"

# Set timezone
ENV TZ=Europe/Paris \
    DEBIAN_FRONTEND=noninteractive

# Install OpenLDAP and required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        slapd \
        ldap-utils \
        ca-certificates \
        libsasl2-2 \
        libsasl2-modules \
        libsasl2-modules-db \
        procps \
        psmisc \
        gettext-base \
        tzdata && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create directories for schemas, ldifs, and data
RUN mkdir -p /schemas /ldifs /data/ldap /data/slapd.d && \
    chmod -R 755 /schemas /ldifs /data

# LDIF files are no longer baked into the image.
# In Kubernetes : mount a ConfigMap on /ldifs
# In Docker     : bind-mount a host directory on /ldifs.
#COPY 01_ldap_ou.ldif /ldifs/01_ldap_ou.ldif
#COPY 02_ldap_users.ldif /ldifs/02_ldap_users.ldif
#COPY 03_ldap_groups.ldif /ldifs/03_ldap_groups.ldif
#COPY 00_ldap_schema.ldif /schemas/schema.ldif

# RUDI LDAP Configuration Environment Variables
ENV LDAP_PORT_NUMBER=1389 \
    LDAP_ROOT=dc=rudi,dc=fr \
    LDAP_ADMIN_USERNAME=admin \
    LDAP_ADMIN_PASSWORD=le_password \
    LDAP_ADD_SCHEMAS=yes \
    LDAP_CUSTOM_SCHEMA_FILE=/schemas/schema.ldif \
    LDAP_SKIP_DEFAULT_TREE=yes \
    LDAP_CUSTOM_LDIF_DIR=/ldifs \
    LDAP_LOGLEVEL=256 \
    LDAP_ALLOW_ANON_BINDING=yes \
    LDAP_ULIMIT_NOFILES=1024

# Additional LDAP configuration options (commented by default)
# ENV LDAP_CONFIG_ADMIN_ENABLED=yes
# ENV LDAP_CONFIG_ADMIN_USERNAME=admin
# ENV LDAP_CONFIG_ADMIN_PASSWORD=configpassword
# ENV LDAP_USERS=user01,user02
# ENV LDAP_PASSWORDS=password1,password2
# ENV LDAP_USER_DC=users
# ENV LDAP_GROUP=readers
# ENV LDAP_EXTRA_SCHEMAS=cosine,inetorgperson,nis

# Keep a copy of the default slapd.d config generated by the Debian package
# so the entrypoint can restore it when /etc/ldap/slapd.d is mounted from an empty PVC.
RUN cp -a /etc/ldap/slapd.d /opt/slapd-defaults

# Copy entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Create non-root user for running slapd
RUN mkdir -p /var/run/slapd && \
    chown -R openldap:openldap /data /schemas /ldifs /etc/ldap/slapd.d /var/lib/ldap /var/run/slapd && \
    chmod 755 /var/run/slapd

# Expose LDAP ports
EXPOSE 1389 1636

# Set working directory
WORKDIR /data

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["slapd", "-d", "256", "-h", "ldap://0.0.0.0:1389/ ldapi:///", "-F", "/etc/ldap/slapd.d"]