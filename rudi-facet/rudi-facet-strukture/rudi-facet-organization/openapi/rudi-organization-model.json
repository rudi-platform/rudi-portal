{
	"openapi": "3.0.0",
	"info": {
		"description": "API Public Providers Rudi",
		"version": "0.0.1",
		"title": "rudi-providers-api",
		"termsOfService": "http://swagger.io/terms/",
		"contact": {
			"email": "contact@rudi.fr"
		},
		"license": {
			"name": "Apache 2.0",
			"url": "http://www.apache.org/licenses/LICENSE-2.0.html"
		}
	},
	"paths": {
	},
	"components": {
		"schemas": {
			"AbstractLongIdDto": {
				"type": "object",
				"properties": {
					"uuid": {
						"type": "string",
						"format": "uuid",
						"readOnly": true
					}
				}
			},
			"AssetDescription": {
				"type": "object",
				"properties": {
					"object_type": {
						"type": "string"
					},
					"uuid": {
						"type": "string",
						"format": "uuid"
					}
				},
				"discriminator": {
					"propertyName": "object_type",
					"mapping": {
						"Organization": "#/components/schemas/Organization"
					}
				}
			},
			"OrganizationStatus": {
				"description": "Statut représentant l'état de création de l'orgnization",
				"enum": [
					"DRAFT",
					"IN_PROGRESS",
					"CANCELLED",
					"VALIDATED",
					"DISENGAGED"
				]
			},
			"TaskSearchCriteria": {
				"description": "Critère de recherche de tâches BPMN",
				"type": "object",
				"properties": {
					"as_admin": {
						"description": "Recherche en tant qu'administrateur",
						"type": "boolean"
					},
					"process_definition_keys": {
						"description": "Clés de définition de processus",
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"status": {
						"description": "Statuts des tâches",
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Status"
						}
					},
					"functional_status": {
						"description": "Statuts fonctionnels",
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"min_creation_date": {
						"description": "Date de création minimale",
						"type": "string",
						"format": "date-time"
					},
					"max_creation_date": {
						"description": "Date de création maximale",
						"type": "string",
						"format": "date-time"
					},
					"description": {
						"description": "Description de la tâche",
						"type": "string"
					},
					"user_login": {
						"description": "Login de l'utilisateur assigné",
						"type": "string"
					}
				}
			},
			"StruktureTaskSearchCriteria": {
				"description": "Critère de recherche de tâches Strukture",
				"type": "object",
				"allOf": [
					{
						"$ref": "#/components/schemas/TaskSearchCriteria"
					},
					{
						"properties": {
							"name": {
								"description": "Nom de l'organisation",
								"type": "string"
							},
							"organization_status": {
								"$ref": "#/components/schemas/OrganizationStatus"
							},
							"organization_uuid": {
								"description": "UUID de l'organisation",
								"type": "string",
								"format": "uuid"
							}
						}
					}
				]
			},
			"Organization": {
				"description": "Organisation",
				"type": "object",
				"required": [
					"name",
					"openingDate",
					"password",
					"description"
				],
				"allOf": [
					{
						"$ref": "#/components/schemas/AssetDescription"
					},
					{
						"properties": {
							"name": {
								"description": "Nom",
								"type": "string"
							},
							"organizationStatus": {
								"$ref": "#/components/schemas/OrganizationStatus"
							},
							"password": {
								"type": "string",
								"description": "Mot de passe de l'utilisateur ROBOT associé à l'organisation"
							},
							"openingDate": {
								"type": "string",
								"format": "date-time",
								"description": "Date de début d'activité"
							},
							"closingDate": {
								"type": "string",
								"format": "date-time",
								"description": "Une date de fin d'activité"
							},
							"description": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						}
					}
				]
			},
			"OrganizationMember": {
				"description": "Membre d'une organisation",
				"type": "object",
				"required": [
					"role"
				],
				"allOf": [
					{
						"$ref": "#/components/schemas/AbstractLongIdDto"
					},
					{
						"properties": {
							"user_uuid": {
								"description": "UUID de l'utilisateur dans ACL",
								"type": "string",
								"format": "uuid"
							},
							"login": {
								"description": "Login de l'utilisateur dans ACL",
								"type": "string"
							},
							"role": {
								"$ref": "#/components/schemas/OrganizationRole"
							},
							"added_date": {
								"description": "Date d'ajout du membre dans l'organisation",
								"type": "string",
								"format": "date-time"
							}
						}
					}
				]
			},
			"OrganizationRole": {
				"description": "Rôle dans une organisation",
				"type": "string",
				"enum": [
					"EDITOR",
					"ADMINISTRATOR"
				]
			},
			"PagedList": {
				"description": "Liste paginée d'éléments",
				"type": "object",
				"required": [
					"total",
					"elements"
				],
				"properties": {
					"total": {
						"description": "Nombre total d'éléments pour cette recherche (peut être supérieur au nombre d'éléments de la page courante)",
						"type": "integer",
						"format": "int64"
					}
				}
			},
			"PagedOrganizationList": {
				"description": "Liste paginée d'organisations",
				"type": "object",
				"allOf": [
					{
						"$ref": "#/components/schemas/PagedList"
					},
					{
						"properties": {
							"elements": {
								"description": "Organisations de la page courante pour cette recherche",
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/Organization"
								}
							}
						}
					}
				]
			},
			"FieldType": {
				"type": "string",
				"description": "Type des champs",
				"enum": [
					"LONG",
					"DOUBLE",
					"STRING",
					"BOOLEAN",
					"DATE",
					"LIST",
					"TEXT",
					"RICHTEXT",
					"ADDRESS",
					"ATTACHMENT",
					"HIDDEN"
				]
			},
			"ValidatorType": {
				"type": "string",
				"enum": [
					"REQUIRED",
					"MAXLENGTH",
					"POSITIVE",
					"NEGATIVE",
					"REGEXP",
					"EMAIL"
				]
			},
			"Validator": {
				"type": "object",
				"properties": {
					"type": {
						"$ref": "#/components/schemas/ValidatorType"
					},
					"attribute": {
						"type": "string"
					}
				}
			},
			"FieldDefinition": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"help": {
						"type": "string"
					},
					"type": {
						"type": "object",
						"$ref": "#/components/schemas/FieldType"
					},
					"readOnly": {
						"type": "boolean"
					},
					"required": {
						"type": "boolean"
					},
					"multiple": {
						"type": "boolean"
					},
					"extendedType": {
						"type": "string"
					},
					"validators": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Validator"
						}
					}
				}
			},
			"Field": {
				"type": "object",
				"properties": {
					"values": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"definition": {
						"type": "object",
						"$ref": "#/components/schemas/FieldDefinition"
					}
				}
			},
			"Section": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"help": {
						"type": "string"
					},
					"readOnly": {
						"type": "boolean"
					},
					"fields": {
						"type": "array",
						"items": {
							"type": "object",
							"$ref": "#/components/schemas/Field"
						}
					}
				}
			},
			"Form": {
				"type": "object",
				"properties": {
					"type": {
						"type": "string"
					},
					"sections": {
						"type": "array",
						"items": {
							"type": "object",
							"$ref": "#/components/schemas/Section"
						}
					}
				}
			},
			"Status": {
				"type": "string",
				"description": "Etat d'une tâche",
				"enum": [
					"DRAFT",
					"PENDING",
					"CANCELLED",
					"COMPLETED",
					"DELETED"
				]
			},
			"Action": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"form": {
						"type": "object",
						"$ref": "#/components/schemas/Form"
					}
				}
			},
			"Task": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"functionalId": {
						"type": "string"
					},
					"status": {
						"$ref": "#/components/schemas/Status"
					},
					"functionalStatus": {
						"type": "string"
					},
					"initiator": {
						"type": "string"
					},
					"creationDate": {
						"type": "string",
						"format": "date-time"
					},
					"updator": {
						"type": "string"
					},
					"updatedDate": {
						"type": "string",
						"format": "date-time"
					},
					"assignee": {
						"type": "string"
					},
					"actions": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Action"
						}
					},
					"asset": {
						"type": "object",
						"$ref": "#/components/schemas/AssetDescription"
					}
				}
			}
		}
	}
}